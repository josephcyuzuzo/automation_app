<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="USSD Automation App"
        android:textSize="20sp"
        android:textStyle="bold"
        android:layout_marginBottom="20dp" />

    <Button
        android:id="@+id/btn_enable_accessibility"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Enable Accessibility Service"
        android:layout_marginBottom="10dp" />

    <Button
        android:id="@+id/btn_view_logs"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="View Transaction Logs"
        android:layout_marginBottom="20dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Mode Settings"
        android:textSize="16sp"
        android:textStyle="bold"
        android:layout_marginBottom="10dp" />

    <TextView
        android:id="@+id/tv_mode_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Current Mode: LEARNING MODE"
        android:textSize="14sp"
        android:layout_marginBottom="10dp"
        android:textColor="#333333" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="20dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Automation Mode:"
            android:textSize="14sp"
            android:gravity="center_vertical" />

        <ToggleButton
            android:id="@+id/toggle_automation_mode"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textOn="ON"
            android:textOff="OFF"
            android:checked="false" />

    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Learning Mode: Captures PIN during first use\nAutomation Mode: Uses stored PIN automatically"
        android:textSize="12sp"
        android:textColor="#666666"
        android:layout_marginBottom="20dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="TransactionEngine Control"
        android:textSize="16sp"
        android:textStyle="bold"
        android:layout_marginBottom="10dp" />

    <Button
        android:id="@+id/btn_check_balance"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Check Balance (V2 Workflow)"
        android:layout_marginBottom="10dp" />

    <TextView
        android:id="@+id/tv_transaction_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Ready"
        android:textSize="12sp"
        android:textColor="#666666"
        android:layout_marginBottom="10dp" />

</LinearLayout>
